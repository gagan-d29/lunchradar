{
  "name": "lunchradar-backend",
  "version": "1.0.0",
  "description": "LunchRadar API — find open, uncrowded lunch spots near your campus",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node ensure-deps.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "preseed": "node ensure-deps.js",
    "seed": "node seed.js",
    "export": "node export-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
